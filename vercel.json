{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?action=$1"
    },
    {
      "source": "/admin",
      "destination": "/api/index.py?action=admin"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
